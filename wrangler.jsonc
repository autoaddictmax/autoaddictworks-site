{
  // Cloudflare Workers static-assets config. Build: python3 build.py · Deploy: npx wrangler deploy
  "name": "autoaddictworks-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
