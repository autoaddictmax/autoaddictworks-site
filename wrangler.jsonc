{
  // Cloudflare Worker: static site in ./dist plus /api/lead form relay (src/worker.js).
  // Build: python3 build.py · Deploy: npx wrangler deploy
  // Secret required in the dashboard: GHL_WEBHOOK_URL (Settings > Variables and Secrets)
  "name": "autoaddictworks-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Keep variables set in the dashboard when deploying from GitHub.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
